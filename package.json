{
  "name": "@kleora-io/node",
  "version": "0.1.0",
  "type": "module",
  "description": "Kleora Node SDK — access-token verification, JWKS cache, express and fastify middlewares, and the typed management client.",
  "license": "Apache-2.0",
  "homepage": "https://kleora.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kleora-io/kleora-node.git"
  },
  "bugs": {
    "url": "https://github.com/kleora-io/kleora-node/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.24.0",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "generate:client": "node scripts/generate-client.mjs",
    "build": "tsup",
    "prepare": "tsup",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "jose": "^6.2.10"
  },
  "peerDependencies": {
    "express": "^5.0.0",
    "fastify": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "fastify": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.0",
    "eslint": "^10.0.0",
    "express": "^5.2.1",
    "fastify": "^5.12.1",
    "openapi-typescript": "^7.13.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
